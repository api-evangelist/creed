              "token": "{{bearerToken}}"
            }
          },
          "docs": "Generate an image using OpenAI's image generation API.\n\nThis endpoint accepts an image upload and various parameters to transform\nthe image according to the provided prompt and style settings."
        }
      ]
    }
  ],
  "bundled": true
}