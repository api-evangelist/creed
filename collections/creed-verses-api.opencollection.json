{
  "opencollection": "1.0.0",
  "info": {
    "name": "Creed achievements verses API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "verses",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Save Verse",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/verses/save",
            "headers": [
              {
                "name": "x-user-id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Save a Bible verse to the user's profile.\nPrevents duplicate verses from being saved."
        },
        {
          "info": {
            "name": "Get Saved Verses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/verses",
            "headers": [
              {
                "name": "x-user-id",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all saved verses for the current user."
        },
        {
          "info": {
            "name": "Delete Saved Verse",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/verses",
            "headers": [
              {
                "name": "x-user-id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a saved verse from the user's profile."
        }
      ]
    }
  ],
  "bundled": true
}