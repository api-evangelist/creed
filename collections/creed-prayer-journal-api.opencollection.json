{
  "opencollection": "1.0.0",
  "info": {
    "name": "Creed achievements prayer-journal API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "prayer-journal",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Prayer Journals",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/prayer-journals",
            "headers": [
              {
                "name": "x-user-id",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Fetch all prayer journals for the authenticated user."
        },
        {
          "info": {
            "name": "Add Prayer Journal",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/prayer-journal",
            "headers": [
              {
                "name": "x-user-id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Add a new prayer journal entry for the authenticated user."
        },
        {
          "info": {
            "name": "Delete Prayer Journal",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/prayer-journal/:prayer_journal_id",
            "headers": [
              {
                "name": "x-user-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "prayer_journal_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a prayer journal entry for the authenticated user."
        }
      ]
    }
  ],
  "bundled": true
}