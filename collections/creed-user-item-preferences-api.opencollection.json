{
  "opencollection": "1.0.0",
  "info": {
    "name": "Creed achievements user-item-preferences API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "user-item-preferences",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get User Item Preferences",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/user-item-preferences",
            "headers": [
              {
                "name": "x-user-id",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Fetch the current user's cosmetic/display preferences from the\nuser_item_preferences table. Returns a record with null fields if no row exists."
        },
        {
          "info": {
            "name": "Update User Item Preferences",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/user-item-preferences",
            "headers": [
              {
                "name": "x-user-id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update user cosmetic/display preferences in the user_item_preferences table.\nUpserts on user_id so a row is created on first write."
        }
      ]
    }
  ],
  "bundled": true
}