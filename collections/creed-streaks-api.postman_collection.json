        {
          "id": "fd1e0a88-e03f-49fc-8acf-ea8f45c326f8",
          "name": "Update Oneoff Event",
          "request": {
            "name": "Update Oneoff Event",
            "description": {
              "content": "Update one-off daily event completion for a user.\n\nAuthentication methods:\n1. Regular user auth via Bearer token\n2. Admin auth via X-API-Key and X-User-ID headers\n\nThis will update the last_oneoff_daily_event timestamp and trigger streak calculation.\nUses user's timezone from current_user if available, otherwise queries user_info table.\n\nQuery parameters:\n- restore: If true, restore a broken streak by incrementing the last active streak instead of starting fresh.\n\nRequest body (optional):\n- useFreeOffer: If true, increment the free_restore_count when restoring.\n- txnId: Transaction ID if the user paid for the restore.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "streaks",
                "extend"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
