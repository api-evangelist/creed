        {
          "id": "08a2a4c1-6721-4593-807e-900e44d813eb",
          "name": "Schedule Daily Notifications",
          "request": {
            "name": "Schedule Daily Notifications",
            "description": {
              "content": "Daily cron job endpoint to schedule notifications for all users.\nThis should be called once per day (e.g., at midnight UTC).\n\nFor each user with push tokens:\n- Randomly selects a time slot (morning/noon/night)\n- Schedules a notification with content appropriate for that time\n- Respects user's timezone for scheduling\n\nTasks are queued in Redis and processed by Celery workers.\nUse days_ahead to override the default 2-day lead time.\n\nRequires x-api-key header for authentication.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "scheduled-notifications",
                "admin",
                "schedule-daily"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "days_ahead",
                  "value": "<integer>",
                  "description": "Days ahead to schedule for (default: 2)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) ",
                "key": "x-api-key",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
