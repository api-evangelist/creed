          "id": "f2f82242-eeb0-451b-a5c9-e6ac46e60920",
          "name": "Send Due Notifications",
          "request": {
            "name": "Send Due Notifications",
            "description": {
              "content": "5-minute cron job endpoint to send all due notifications.\nThis should be called every 5 minutes.\n\nChecks for all pending notifications scheduled for current time or earlier and sends them.\nUpdates notification status to 'sent' or 'failed' accordingly.\n\nTasks are queued in Redis and processed by Celery workers.\n\nRequires x-api-key header for authentication.",
              "type": "text/plain"
            },
