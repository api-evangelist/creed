{
  "opencollection": "1.0.0",
  "info": {
    "name": "Creed achievements live-streams API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "live-streams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Active Stream",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/live-streams/active"
          },
          "docs": "Get Active Stream"
        },
        {
          "info": {
            "name": "Start Stream",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/live-streams/start",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Start Stream"
        },
        {
          "info": {
            "name": "Stop Stream",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/live-streams/stop",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ]
          },
          "docs": "Stop Stream"
        },
        {
          "info": {
            "name": "Get Live Stream Comments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/live-streams/:stream_id/comments",
            "params": [
              {
                "name": "stream_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "since",
                "value": "",
                "type": "query",
                "description": "ISO timestamp — return only comments after this time"
              }
            ]
          },
          "docs": "Get comments for a live stream. Pass `since` for incremental fetching."
        },
        {
          "info": {
            "name": "Submit Live Stream Comment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/live-streams/:stream_id/comments",
            "headers": [
              {
                "name": "x-user-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "stream_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Submit a comment on a live stream."
        }
      ]
    }
  ],
  "bundled": true
}