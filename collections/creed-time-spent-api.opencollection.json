          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/time-spent",
            "headers": [
              {
                "name": "x-user-id",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get total time spent by the user across all sessions.\nReturns time in minutes."
        },
        {
          "info": {
            "name": "Submit Time",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/time-spent",
            "headers": [
              {
                "name": "x-user-id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Submit time spent to track time in the app."
        }
      ]
    }
  ],
  "bundled": true
